                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Nombre de imagen generado correctamente con fecha compacta\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.nombre).to.eql('monitor');",
                  "    pm.expect(json.fechaIngreso).to.eql('2026-10-13');",
                  "    pm.expect(json.imagen).to.match(/^monitor_20261013\\./);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "nombre",
