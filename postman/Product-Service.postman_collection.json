    {
      "name": "3. Casos de Error - Negocio (404 & 409)",
      "item": [
        {
          "name": "POST - Error 409 Conflict: Producto Duplicado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test(\"Mensaje indica conflicto por producto duplicado\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(409);",
                  "    pm.expect(json.error).to.eql(\"CONFLICT\");",
                  "    pm.expect(json.message).to.include(\"Ya existe un producto con el nombre: laptop\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "nombre",
                  "value": "laptop",
                  "type": "text",
                  "description": "Nombre idéntico al creado en el Caso 1"
                },
                {
                  "key": "descripcion",
                  "value": "Intento de duplicar laptop",
                  "type": "text"
                },
                {
                  "key": "cantidad",
                  "value": "2",
                  "type": "text"
