                  "type": "text"
                },
                {
                  "key": "fechaIngreso",
                  "value": "20261013",
                  "type": "text",
                  "description": "Formato compacto yyyyMMdd"
                },
                {
                  "key": "imagen",
                  "type": "file",
                  "src": "C:/dev/floci/imagen-prueba.jpeg"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Prueba de aceptación de formato fecha yyyyMMdd (ej: 20261013)"
          }
        },
        {
          "name": "GET - Listar Todos los Productos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Retorna lista de productos\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "    pm.expect(json.length).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "GET - Obtener Producto por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Producto encontrado con id correcto\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.idProduct).to.eql(Number(pm.collectionVariables.get(\"createdProductId\")));",
                  "    pm.expect(json.imagenUrl).to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{createdProductId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{createdProductId}}"]
            }
          }
        }
      ]
    },
