{
  "info": {
    "_postman_id": "c1f2b4e0-5a3d-4c8e-9d1a-2b3c4d5e6f7a",
    "name": "Product Service - Clean Architecture & S3 Floci",
    "description": "Colección completa de pruebas para el servicio de productos con almacenamiento de imágenes en S3 (Floci) y base de datos H2. Incluye casos de éxito y de error con assertions automatizadas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "createdProductId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Casos de Éxito",
      "item": [
        {
          "name": "POST - Crear Producto (Fecha ISO yyyy-MM-dd)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Respuesta contiene datos válidos del producto\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.idProduct).to.be.a('number');",
                  "    pm.expect(json.nombre).to.eql('laptop');",
                  "    pm.expect(json.cantidad).to.eql(10);",
                  "    pm.expect(json.monto).to.eql(1299.99);",
                  "    pm.expect(json.fechaIngreso).to.eql('2026-10-13');",
                  "    pm.expect(json.imagen).to.match(/^laptop_20261013\\./);",
                  "    pm.expect(json.imagenUrl).to.include('/imagenes-app/');",
                  "    ",
                  "    // Guardar ID para pruebas posteriores",
                  "    pm.collectionVariables.set(\"createdProductId\", json.idProduct);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "nombre",
                  "value": "laptop",
                  "type": "text"
                },
                {
                  "key": "descripcion",
                  "value": "Laptop gamer de alta gama i7 16GB RAM",
                  "type": "text"
                },
                {
                  "key": "cantidad",
                  "value": "10",
                  "type": "text"
                },
                {
                  "key": "monto",
                  "value": "1299.99",
                  "type": "text"
                },
                {
                  "key": "fechaIngreso",
                  "value": "2026-10-13",
                  "type": "text",
                  "description": "Formato ISO yyyy-MM-dd"
                },
                {
                  "key": "imagen",
                  "type": "file",
                  "src": "C:/dev/floci/imagen-prueba.jpeg",
                  "description": "Archivo de imagen a guardar en Floci S3"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Crea un producto y sube la imagen a S3 Floci con nombre: laptop_20261013.<ext>"
          }
        },
        {
          "name": "POST - Crear Producto (Fecha Compacta yyyyMMdd)",
          "event": [
            {
