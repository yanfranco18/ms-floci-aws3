                {
                  "key": "descripcion",
                  "value": "Monitor 4K UHD 144Hz 27 pulgadas",
                  "type": "text"
                },
                {
                  "key": "cantidad",
                  "value": "5",
                  "type": "text"
                },
                {
                  "key": "monto",
